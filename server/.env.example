# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
# Local database password. Change it in both lines together (and inside the database: see README).
POSTGRES_PASSWORD=platewatch
DATABASE_URL=postgres://platewatch:platewatch@localhost:5432/platewatch

# Production only, for databases signed by their own CA (DigitalOcean, Supabase): its CA certificate as PEM text.
# Not needed locally or for providers with public certificates (Neon).
DATABASE_CA_CERT=

# Browser origins allowed to make state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# HMAC key for OTP hashes. Long random string in production: `openssl rand -base64 48`.
OTP_PEPPER=dev-only-pepper-change-me

# How codes are sent: console (prints to the server log), whatsapp, sms, or whatsapp+sms (SMS fallback).
OTP_CHANNEL=console
# Include the code in the API response, for scripts and automated checks only (the site never shows it). Refused in production.
OTP_DEV_ECHO=false

# WhatsApp Cloud API (Meta). Needs an approved authentication template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=platewatch_login_code
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# MSG91 SMS fallback. Needs a DLT-approved OTP template.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# File storage: local (a folder, server/.data/uploads, kept across restarts), memory (tests; lost on restart)
# or s3 (Cloudflare R2, Amazon S3, or the local SeaweedFS container). Production needs s3.
STORAGE=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=platewatch
S3_ACCESS_KEY_ID=platewatch
S3_SECRET_ACCESS_KEY=platewatch-secret
S3_FORCE_PATH_STYLE=true

# Show reviewer-approved kitchen photos on public profiles. Photos a reviewer marks as showing people are always left out.
PUBLIC_GALLERY=true

# Faces in uploaded photos are found and pixelated before the photo is stored. Required in production.
FACE_BLUR=true

# Notifications outside the site: console (the server log), whatsapp, or off. WhatsApp needs an approved
# utility template (WHATSAPP_NOTIFY_TEMPLATE) with two body parameters: {{1}} the title, {{2}} the details.
NOTIFY_CHANNEL=console
WHATSAPP_NOTIFY_TEMPLATE=platewatch_update

# Version of the consent text shown at login. Bump it when the text changes.
CONSENT_VERSION=2026-09-v1

# Per-user daily limits for non-admin writes.
REPORTS_PER_DAY=1
# Reports per person in any 7 days. Separately, one report about the same restaurant per 7 days.
REPORTS_PER_WEEK=5
UPLOADS_PER_DAY=60
